{
  "manifest_version": 3,
  "name": "AI Smart Cleaner",
  "version": "1.0",
  "description": "Delete old AI chats",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*", 
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*"],
      "js": ["content.js"]
    }
  ]
}
